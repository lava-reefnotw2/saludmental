      <depDate date=""/>
      <distDate date=""/>
    </distStmt>
    <serStmt>
      <serName>Global School-Based Student Health Survey</serName>
      <serInfo><![CDATA[This is the third GSHS conducted by Uruguay.]]></serInfo>
    </serStmt>
    <verStmt>
      <version date="">Public-use dataset</version>
      <verResp/>
      <notes><![CDATA[]]></notes>
