    <labl>Sometimes</labl>
  </catgry>
  <catgry>
    <catValu>4</catValu>
    <labl>Most of the time</labl>
  </catgry>
  <catgry>
    <catValu>5</catValu>
    <labl>Always</labl>
  </catgry>
  <catgry>
    <catValu>Sysmiss</catValu>
  </catgry>
</var>
