<var ID="V488" name="q4" files="F5" dcml="2" intrvl="contin">
  <varFormat type="numeric"/>
  <labl>How tall are you</labl>
  <qstn>
    <preQTxt>The next 3 questions ask about your height, weight, and going hungry.</preQTxt>
    <qstnLit>How tall are you without your shoes on? ON THE ANSWER SHEET, WRITE YOUR HEIGHT IN THE SHADED BOXES AT THE TOP OF THE GRID. THEN FILL IN THE OVAL BELOW EACH NUMBER.</qstnLit>
  </qstn>
  <sumStat type="vald">36052</sumStat>
  <sumStat type="invd">20929</sumStat>
  <sumStat type="min">1.2</sumStat>
  <sumStat type="max">2.03</sumStat>
  <sumStat type="mean">1.643</sumStat>
  <sumStat type="stdev">0.0969</sumStat>
</var>
<var ID="V489" name="q5" files="F5" dcml="2" intrvl="contin">
  <varFormat type="numeric"/>
  <labl>How much do you weigh</labl>
  <qstn>
    <preQTxt>The next 3 questions ask about your height, weight, and going hungry.</preQTxt>
    <qstnLit>How much do you weigh without your shoes on? ON THE ANSWER SHEET, WRITE YOUR WEIGHT IN THE SHADED BOXES AT THE TOP OF THE GRID. THEN FILL IN THE OVAL BELOW EACH NUMBER.</qstnLit>
  </qstn>
  <sumStat type="vald">36052</sumStat>
  <sumStat type="invd">20929</sumStat>
  <sumStat type="min">27</sumStat>
  <sumStat type="max">187</sumStat>
  <sumStat type="mean">60.212</sumStat>
  <sumStat type="stdev">14.724</sumStat>
</var>
<var ID="V490" name="q6" files="F5" intrvl="discrete">
  <varFormat type="numeric"/>
  <labl>How often went hungry</labl>
  <qstn>
    <preQTxt>The next 3 questions ask about your height, weight, and going hungry.</preQTxt>
    <qstnLit>During the past 30 days, how often did you go hungry because there was not enough food in your home?</qstnLit>
  </qstn>
  <sumStat type="vald">56482</sumStat>
  <sumStat type="invd">499</sumStat>
  <catgry>
