# SP-07 Configuración de Entorno de Investigación
# Base de datos PostgreSQL (opcional, fallback automático a modo local CSV en ./data)
DATABASE_URL=postgresql+psycopg2://sp07:sp07_dev_password@localhost:5432/sp07_db

# Parámetros del servidor Streamlit
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Reproducibilidad científica
RANDOM_SEED=42
